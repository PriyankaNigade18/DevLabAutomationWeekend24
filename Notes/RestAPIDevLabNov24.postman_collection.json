							"function test()\r",
							"{\r",
							"    console.log(\"Test function is calling......\");\r",
							"}\r",
							"\r",
							"//how to call function\r",
							"test();\r",
							"\r",
							"\r",
							"//arrow function ()=>\r",
							"\r",
							"hello=()=>\r",
							"{\r",
							"console.log(\"Arrow function is calling......\");\r",
							"}\r",
							"\r",
							"//call\r",
							"hello();\r",
							"\r",
							"\r",
